#!/usr/bin/env bash

# Пути к конфигам
GTK_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini"

# Применение GTK-темы
if [ -f "$GTK_CONFIG" ]; then
    # Вытягиваем значения корректно
    gtk_theme=$(grep '^gtk-theme-name' "$GTK_CONFIG" | cut -d'=' -f2 | tr -d '[:space:]' | tr -d '"')
    icon_theme=$(grep '^gtk-icon-theme-name' "$GTK_CONFIG" | cut -d'=' -f2 | tr -d '[:space:]' | tr -d '"')
    # Для курсора оставляем пробелы (Chicago 95 Standard)
    cursor_theme=$(grep '^gtk-cursor-theme-name' "$GTK_CONFIG" | cut -d'=' -f2 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr -d '"')

    # Применение gsettings
    [ -n "$gtk_theme" ] && gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme"
    [ -n "$icon_theme" ] && gsettings set org.gnome.desktop.interface icon-theme "$icon_theme"
    [ -n "$cursor_theme" ] && gsettings set org.gnome.desktop.interface cursor-theme "$cursor_theme"

    # Экспорт для текущей сессии
    export GTK_THEME="$gtk_theme"
    export ICON_THEME="$icon_theme"

    # Применение в Hyprland (если Wayland)
    if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
        hyprctl setcursor "$cursor_theme" 32
    fi
fi